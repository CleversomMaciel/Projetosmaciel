# Copie para .env (nunca versione o .env). Em produção use o gerenciador de segredos da hospedagem.
NODE_ENV=development
PORT=3000
# URL pública do site, sem barra no final (usada em canonical, Open Graph e sitemap)
PUBLIC_URL=http://localhost:3000
# Número de proxies confiáveis na frente do Node (1 atrás de um balanceador). Afeta o IP usado no rate limit.
TRUST_PROXY=0

# --- Supabase (Project Settings > API)
SUPABASE_URL=
# chave pública (anon): vai para o navegador, protegida por RLS
SUPABASE_ANON_KEY=
# chave de serviço: ignora RLS. SOMENTE no backend. Nunca no frontend, nunca em repositório.
SUPABASE_SERVICE_ROLE_KEY=

# --- Consulta de CNPJ: ordem = prioridade. Opções: brasilapi, serpro
CNPJ_PROVIDERS=brasilapi
CNPJ_TIMEOUT_MS=6000
CNPJ_CACHE_TTL_SECONDS=604800
# Só preencha após contratar a API Consulta CNPJ na Loja Serpro (serviço pago)
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
SERPRO_CNPJ_PATH=/consulta-cnpj-df/v2/basica

# --- Consulta de CEP: opções: viacep, brasilapi
CEP_PROVIDERS=viacep,brasilapi
CEP_TIMEOUT_MS=4000
CEP_CACHE_TTL_SECONDS=2592000

# --- Mercado Pago (Suas integrações > aplicação)
# Access Token da aplicação (use credenciais de TESTE fora de produção)
MP_ACCESS_TOKEN=
# "Assinatura secreta" gerada ao configurar o webhook. Sem ela todo webhook é recusado.
MP_WEBHOOK_SECRET=
# Marketplace (pagamento dividido): Client ID e Client Secret da MESMA aplicação.
# No painel do Mercado Pago, cadastre a URL de redirecionamento: <PUBLIC_URL>/api/mp/callback
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Chave que cifra os tokens das contas dos profissionais. Gere com: openssl rand -hex 32
# Guarde com o mesmo cuidado da service role key; trocá-la obriga todos a reconectar a conta.
MP_TOKEN_ENCRYPTION_KEY=

# --- Proteção contra robôs (Cloudflare Turnstile)
# Chave PÚBLICA do site. A chave secreta é cadastrada só no painel do Supabase:
# Authentication > Bot and Abuse Protection > Enable CAPTCHA protection (Turnstile).
TURNSTILE_SITE_KEY=
# Redireciona HTTP -> HTTPS (padrão: ligado em produção). Exige TRUST_PROXY >= 1 atrás de proxy.
# FORCE_HTTPS=true

# --- Política comercial
# Permite contratante pessoa física (CPF). Mantenha false até a decisão jurídica/comercial.
ALLOW_PF_CONTRACTORS=false

# --- Opcional: URLs alternativas dos provedores (espelho próprio ou homologação)
# VIACEP_BASE_URL=https://viacep.com.br
# BRASILAPI_BASE_URL=https://brasilapi.com.br
# MP_API_BASE=https://api.mercadopago.com
