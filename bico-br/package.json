{
  "name": "bico-br",
  "version": "0.1.0",
  "private": true,
  "description": "Bico BR — marketplace brasileiro de trabalho remoto",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "build:css": "tailwindcss -c tailwind.config.cjs -i web/css/input.css -o web/assets/app.css --minify",
    "build": "node scripts/build-assets.mjs && npm run build:css",
    "test": "node --test --test-reporter=spec \"server/test/*.test.js\"",
    "test:db": "bash supabase/tests/run.sh",
    "test:e2e": "bash tests/e2e/run.sh",
    "model": "node docs/modelo-financeiro/modelo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "tailwindcss": "^3.4.14"
  }
}
